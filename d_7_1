        // 🧮 實驗室 2：記帳與圓形圖邏輯 (預設值剛好 1000元 / 100%)
        function updateBookkeepingLab() {
            const food = parseInt(document.getElementById('sim-bk-food').value);
            const book = parseInt(document.getElementById('sim-bk-book').value);
            const fun = parseInt(document.getElementById('sim-bk-fun').value);
            const bus = parseInt(document.getElementById('sim-bk-bus').value);

            document.getElementById('bk-food-val').innerText = food;
            document.getElementById('bk-book-val').innerText = book;
            document.getElementById('bk-fun-val').innerText = fun;
            document.getElementById('bk-bus-val').innerText = bus;

            const total = food + book + fun + bus;
            document.getElementById('bk-total-sum').innerText = `${total} 元`;

            // 計算百分比
            const foodPct = Math.round((food / total) * 1000) / 10;
            const bookPct = Math.round((book / total) * 1000) / 10;
            const funPct = Math.round((fun / total) * 1000) / 10;
            const busPct = Math.round((bus / total) * 1000) / 10;

            document.getElementById('bk-food-pct').innerText = `${foodPct}%`;
            document.getElementById('bk-book-pct').innerText = `${bookPct}%`;
            document.getElementById('bk-fun-pct').innerText = `${funPct}%`;
            document.getElementById('bk-bus-pct').innerText = `${busPct}%`;

            const sumPct = Math.round((foodPct + bookPct + funPct + busPct) * 10) / 10;

            // 繪製 SVG 圓形圖
            const svg = document.getElementById('pie-chart-svg');
            const slices = [
                { name: '伙食', val: food, pct: foodPct, color: '#3b82f6' },
                { name: '書籍', val: book, pct: bookPct, color: '#10b981' },
                { name: '娛樂', val: fun, pct: funPct, color: '#a855f7' },
                { name: '交通', val: bus, pct: busPct, color: '#f59e0b' }
            ];

            let cumulativePct = 0;
            let pathHtml = '';
            let textHtml = '';

            slices.forEach(s => {
                if (s.pct > 0) {
                    const startAngle = (cumulativePct / 100) * 360 - 90;
                    cumulativePct += s.pct;
                    const endAngle = (cumulativePct / 100) * 360 - 90;
                    const midAngle = (startAngle + endAngle) / 2;

                    const x1 = 50 + 40 * Math.cos((Math.PI * startAngle) / 180);
                    const y1 = 50 + 40 * Math.sin((Math.PI * startAngle) / 180);
                    const x2 = 50 + 40 * Math.cos((Math.PI * endAngle) / 180);
                    const y2 = 50 + 40 * Math.sin((Math.PI * endAngle) / 180);

                    const largeArc = s.pct > 50 ? 1 : 0;
                    pathHtml += `<path d="M 50 50 L ${x1} ${y1} A 40 40 0 ${largeArc} 1 ${x2} ${y2} Z" fill="${s.color}" opacity="0.9" />`;

                    if (s.pct >= 5) {
                        const tx = 50 + 32 * Math.cos((Math.PI * midAngle) / 180);
                        const ty = 50 + 32 * Math.sin((Math.PI * midAngle) / 180);
                        textHtml += `<text x="${tx}" y="${ty}" font-size="3.8" font-weight="bold" fill="#ffffff" text-anchor="middle" dominant-baseline="central">${s.val}元 (${s.pct}%)</text>`;
                    }
                }
            });

            pathHtml += `<circle cx="50" cy="50" r="22" fill="#f8fafc" />`;
            svg.innerHTML = pathHtml + textHtml;

            // 提示總和檢查
            const warnBox = document.getElementById('rounding-warning-box');
            if (sumPct === 100) {
                warnBox.className = "text-xs p-2.5 rounded-lg font-bold w-full text-center bg-green-100 text-green-800 border border-green-300";
                warnBox.innerHTML = `✅ 百分率總和加總為 <b>${sumPct}%</b>！完美剛好！`;
            } else {
                warnBox.className = "text-xs p-2.5 rounded-lg font-bold w-full text-center bg-amber-100 text-amber-800 border border-amber-300";
                warnBox.innerHTML = `💡 四捨五入後加總為 <b>${sumPct}%</b>（非剛好 100%），這是求近似值常見的微小誤差現象哦！`;
            }
        }

