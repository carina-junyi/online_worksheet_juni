            document.getElementById('vote-m-hua-val').innerText = `${mHua} 票`;
            document.getElementById('vote-m-ming-val').innerText = `${mMing} 票`;
            document.getElementById('vote-f-hua-val').innerText = `${fHua} 票`;
            document.getElementById('vote-f-ming-val').innerText = `${fMing} 票`;

            // 計算小計與總計
            const mSub = mHua + mMing;
            const fSub = fHua + fMing;
            const huaSub = mHua + fHua;
            const mingSub = mMing + fMing;
            const grandTotal = mSub + fSub;

            document.getElementById('tbl-m-hua').innerText = mHua;
            document.getElementById('tbl-m-ming').innerText = mMing;
            document.getElementById('tbl-m-sub').innerText = mSub;

            document.getElementById('tbl-f-hua').innerText = fHua;
            document.getElementById('tbl-f-ming').innerText = fMing;
            document.getElementById('tbl-f-sub').innerText = fSub;

            document.getElementById('tbl-hua-sub').innerText = huaSub;
            document.getElementById('tbl-ming-sub').innerText = mingSub;
            document.getElementById('tbl-grand-total').innerText = grandTotal;

            // 長條圖動態高度
            const maxVal = Math.max(1, huaSub, mingSub);
            const huaH = Math.min(70, Math.max(4, (huaSub / maxVal) * 70));
            const mingH = Math.min(70, Math.max(4, (mingSub / maxVal) * 70));

            document.getElementById('bar-hua-num').innerText = `${huaSub}票`;
            document.getElementById('bar-ming-num').innerText = `${mingSub}票`;
            document.getElementById('bar-hua-height').style.height = `${huaH}px`;
            document.getElementById('bar-ming-height').style.height = `${mingH}px`;

            const winnerTag = document.getElementById('vote-winner-tag');
            if (huaSub > mingSub) {
                winnerTag.innerText = "當前領先：小華 🎉";
                winnerTag.className = "text-amber-400 font-bold";
            } else if (mingSub > huaSub) {
                winnerTag.innerText = "當前領先：小明 🎉";
                winnerTag.className = "text-emerald-400 font-bold";
            } else {
                winnerTag.innerText = "當前票數平手 🤝";
                winnerTag.className = "text-slate-300 font-bold";
            }

            // 更新動態計算指引卡
            const guideHtml = `
                <p class="font-bold text-indigo-950 flex items-center mb-1 text-xs">
                    <i data-lucide="calculator" class="w-4 h-4 mr-1 text-indigo-600"></i> 💡 列聯表動態算式解密：
